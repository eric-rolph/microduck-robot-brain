<mujoco model="microduck_demo_1080p">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" iterations="50" solver="Newton" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1920" offheight="1080"/>
    <headlight diffuse="0.75 0.75 0.75" ambient="0.35 0.35 0.35" specular="0.2 0.2 0.2"/>
    <quality shadowsize="2048"/>
  </visual>

  <include file="microduck_walk_backlash.xml"/>

  <worldbody>
    <!-- Target object for fetch & ground pick -->
    <body name="target_ball" pos="0.32 0.0 0.035">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.032" rgba="1.0 0.82 0.05 1" mass="0.02" friction="1.5 0.005 0.0001"/>
    </body>

    <!-- Rough terrain section: low-profile obstacles -->
    <geom name="bump1" type="capsule" fromto="0.55 -0.35 0.005 0.55 0.35 0.005" size="0.008" rgba="0.35 0.42 0.5 1" friction="1.5 0.005 0.0001"/>
    <geom name="bump2" type="capsule" fromto="0.75 -0.35 0.009 0.75 0.35 0.009" size="0.012" rgba="0.35 0.42 0.5 1" friction="1.5 0.005 0.0001"/>
    <geom name="bump3" type="capsule" fromto="0.95 -0.35 0.007 0.95 0.35 0.007" size="0.010" rgba="0.35 0.42 0.5 1" friction="1.5 0.005 0.0001"/>

    <!-- Emergency stop obstacle -->
    <body name="obstacle_box" pos="1.20 0 0.06">
      <geom name="obstacle_geom" type="box" size="0.03 0.14 0.06" rgba="0.9 0.25 0.2 0.9" mass="1.0"/>
    </body>
  </worldbody>
</mujoco>
