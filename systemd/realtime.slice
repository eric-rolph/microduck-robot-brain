[Unit]
Description=Real-Time Microduck Bipedal Control Slice
DefaultDependencies=no
Before=slices.target

[Slice]
# Hard assign this cgroup exclusively to Core 3 (highest core on 4-core Raspberry Pi CM4)
AllowedCPUs=3

# Memory protection: prevent cgroup OOM thrashing
MemoryHigh=512M
MemoryMax=1G

# Prioritize cgroup scheduling weight
CPUWeight=10000
